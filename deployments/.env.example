# ==============================================================================
# Xiaoya Media Server All-in-One 环境变量配置模板
# 使用方式：cp .env.example .env 并修改参数（切勿提交真实 .env 到 Git）
# ==============================================================================

TZ=Asia/Shanghai
HTTP_PORT=8096

# ------------------------------------------------------------------------------
# 1. PostgreSQL 业务数据库配置
# ------------------------------------------------------------------------------
# 单容器 All-in-One 架构已内置轻量 PostgreSQL，数据自动保存在 APP_DATA_DIR/postgres 中，完全持久化。
# 若连接外部远程数据库，可显式配置 POSTGRES_HOST（默认为 127.0.0.1 启用内置数据库）
POSTGRES_USER=emby
POSTGRES_PASSWORD=change_me_to_a_strong_postgres_password
POSTGRES_DB=emby
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. 初始管理员密码（首次建库必填，长度至少 12 位）
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=change_me_admin_12chars
BOOTSTRAP_API_KEY=

# ------------------------------------------------------------------------------
# 3. 小雅配置（关键：将包含 strm.txt 的宿主机目录挂载进容器）
# ------------------------------------------------------------------------------
# 宿主机上小雅的主配置目录（例如 /vol1/1000/xiaoya，里面必须包含 strm.txt）
XIAOYA_DIR=/vol1/1000/xiaoya
# 容器内 strm.txt 的完整路径（默认映射为 /xiaoya-db/strm.txt）
XIAOYA_STRM_PATH=/xiaoya-db/strm.txt

# ------------------------------------------------------------------------------
# 4. 本地媒体与持久化数据目录
# ------------------------------------------------------------------------------
# 生成的 .strm 文件及外挂字幕、海报附件存放目录
MEDIA_DIR=./data/media
# 应用全局持久化数据目录（内置 PostgreSQL 数据库、封面缓存、媒体探测缓存、自动备份）
APP_DATA_DIR=./data/appdata

# ------------------------------------------------------------------------------
# 5. 指定目录监控与同步周期
# ------------------------------------------------------------------------------
MONITOR_ENABLED=true
MONITOR_INTERVAL=10m
# 小雅监控目录（留空表示不预置默认监控目录，可在 Web 管理页面中按需添加）
MONITOR_ROOTS=

# ------------------------------------------------------------------------------
# 6. 小雅 AList 地址与凭据
# ------------------------------------------------------------------------------
# ALIST_BASE_URL: 宿主机/局域网小雅真实服务地址（播放时向其请求解析 302 直链，以及用于后台抓取封面/NFO）
ALIST_BASE_URL=http://192.168.1.10:5678
# STRM_TARGET_BASE_URL: 未播放时写入 .strm 文件的占位基准地址（默认保持小雅标准规范 http://xiaoya.host:5678）
STRM_TARGET_BASE_URL=http://xiaoya.host:5678
XIAOYA_USERNAME=
XIAOYA_PASSWORD=
ALIST_TOKEN=

# ------------------------------------------------------------------------------
# 7. TMDB v3 刮削与识别服务配置（NFO 策略固定为 prefer：本地非空 NFO 优先，缺失时自动刮削 TMDB）
# ------------------------------------------------------------------------------
# 启用 TMDB 刮削引擎（true / false，默认 true）
TMDB_ENABLED=true
# TheMovieDb API Key (v3 auth)，必填，请前往 https://www.themoviedb.org 申请
TMDB_API_KEY=
# 网络代理 ProxyURL (解决国内直连 EOF/阻断问题，例如 http://192.168.1.10:7890 或 socks5://192.168.1.10:7890)
TMDB_PROXY=
# TMDB API Base URL (默认官方接口；如有 Cloudflare 反代或国内镜像加速地址可填入)
TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB 图片前缀地址（默认官方；如有自建图片镜像可填入）
TMDB_IMAGE_URL=https://image.tmdb.org/t/p
# 默认元数据抓取语言（默认 zh-CN 中文优先）
TMDB_LANGUAGE=zh-CN
# 请求速率限制，单位：毫秒/次（默认 250，防触发 429 限流或网络拥塞）
TMDB_RATE_LIMIT_MS=250
# 写入本地海报与 NFO 元数据文件到媒体目录（推荐 1T+ 高速固态/本地硬盘开启，true / false，默认 false）
# 开启后，刮削成功自动将 poster.jpg、fanart.jpg、单集剧照与 tvshow/episodedetails.nfo 异步下载并保存到 NAS 影视目录
TMDB_SAVE_ARTIFACTS=false
