# ==============================================================================
# Xiaoya Media Server V1.0 环境变量模板
# 使用方式：cp .env.example .env 并修改占位参数（切勿提交真实 .env 到 Git）
# ==============================================================================

TZ=Asia/Shanghai
HTTP_PORT=8096

# 1. PostgreSQL 业务数据库配置
POSTGRES_USER=emby
POSTGRES_PASSWORD=change_me_to_a_strong_postgres_password
POSTGRES_DB=emby
POSTGRES_DATA_DIR=./data/postgres

# 2. 初始管理员密码（首次建库必填，长度至少 12 位）
ADMIN_PASSWORD=change_me_admin_12chars
BOOTSTRAP_API_KEY=

# 3. 小雅 SQLite 只读挂载目录（关键：填宿主机父目录而非单文件路径，保证 .db-wal/.db-shm 可见）
XIAOYA_DB_DIR=/vol1/1000/xiaoya/data
XIAOYA_SQLITE_FILENAME=strm_internal.db

# 4. 本地媒体与持久化数据目录
MEDIA_DIR=./data/media
APP_DATA_DIR=./data/appdata

# 5. 指定目录监控与同步周期
MONITOR_ENABLED=true
MONITOR_INTERVAL=10m
MONITOR_ROOTS=/每日更新/电视剧/国产剧（115）,/每日更新/电视剧/国产剧

# 6. 小雅 AList 地址与凭据（用于 STRM 直链生成、过期签名自动刷新、后台浏览搜索入库）
ALIST_BASE_URL=http://192.168.1.10:5678
STRM_TARGET_BASE_URL=http://192.168.1.10:5678
XIAOYA_USERNAME=
XIAOYA_PASSWORD=
ALIST_TOKEN=

# 7. TMDB v3 刮削配置（NFO 策略固定为 prefer：本地非空 NFO 优先，缺失时自动刮削 TMDB）
TMDB_API_KEY=
TMDB_LANGUAGE=zh-CN
